@echo off
chcp 65001 >nul
title 刷课脚本 - 一键独立 EXE 打包工具
echo ========================================================
echo    📚 刷课脚本 - 一键独立可执行程序 (EXE) 打包工具
echo ========================================================
echo.
echo 正在准备打包环境，将项目打包为无需 Python 环境的独立 exe...
echo.

python "%~dp0build_exe.py"

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ========================================================
    echo  ✅ 打包完成！独立 exe 文件已生成在 dist 目录下。
    echo  可将 dist 目录复制到任意 Windows 电脑直接运行。
    echo ========================================================
) else (
    echo.
    echo ========================================================
    echo  ❌ 打包过程中出现错误，请检查上方日志输出。
    echo ========================================================
)

echo.
pause
